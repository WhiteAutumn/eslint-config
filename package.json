{
  "name": "@autumn.dev/eslint-config",
  "type": "module",
  "version": "0.0.16",
  "description": "My personal config for eslint",
  "author": "WhiteAutumn",
  "license": "MIT",
  "main": "./dist/config.js",
  "types": "./dist/config.d.ts",
  "volta": {
    "node": "20.14.0"
  },
  "homepage": "https://github.com/WhiteAutumn/eslint-config",
  "bugs": {
    "url": "https://github.com/WhiteAutumn/eslint-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WhiteAutumn/eslint-config.git"
  },
  "files": [
    "dist",
    "src",
    "config.ts",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsc -w",
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:strict": "cross-env STRICT=true eslint .",
    "lint:strict:report": "npm run lint:strict -- --output-file eslint-report.json --format json",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@stylistic/eslint-plugin": "^4.0.0",
    "@typescript-eslint/utils": "^8.0.0",
    "eslint-plugin-import": "^2.0.0",
    "eslint-plugin-n": "^17.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "devDependencies": {
    "@types/eslint": "^9.0.0",
    "@types/node": "^20.0.0",
    "cross-env": "^10.0.0",
    "eslint": "^9.0.0",
    "typescript": "~5.7.0"
  }
}
