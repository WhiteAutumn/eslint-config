{
  "name": "@autumn.dev/eslint-config",
  "type": "module",
  "version": "0.0.18",
  "description": "My personal config for eslint",
  "author": "WhiteAutumn",
  "license": "MIT",
  "main": "./dist/config.js",
  "types": "./dist/config.d.ts",
  "homepage": "https://github.com/WhiteAutumn/eslint-config",
  "bugs": {
    "url": "https://github.com/WhiteAutumn/eslint-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WhiteAutumn/eslint-config.git"
  },
  "volta": {
    "node": "24.19.0"
  },
  "files": [
    "dist",
    "src",
    "config.ts",
    "LICENSE"
  ],
  "imports": {
    "#config": {
      "types": "./config.ts",
      "default": "./dist/config.js"
    },
    "#common/*": {
      "types": "./src/common/*.ts",
      "default": "./dist/src/common/*.js"
    }
  },
  "scripts": {
    "dev": "tsc -w",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:strict": "cross-env STRICT=true eslint .",
    "lint:strict:report": "npm run lint:strict -- --output-file eslint-report.json --format json",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "~5.10.0",
    "@typescript-eslint/utils": "~8.67.0",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-n": "~18.3.0",
    "eslint-plugin-no-only-tests": "~3.4.0",
    "typescript-eslint": "~8.67.0"
  },
  "devDependencies": {
    "@types/eslint": "^9.0.0",
    "@types/node": "^24.0.0",
    "cross-env": "^10.0.0",
    "eslint": "^9.0.0",
    "typescript": "~6.0.0"
  }
}
