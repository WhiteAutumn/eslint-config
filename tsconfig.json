{
  "exclude": ["node_modules", "dist"],
  
  "compilerOptions": {
    // Target
    "target": "es2024",
    "lib": ["es2024", "esnext.array", "es2025.iterator"],
    "module": "nodenext",
    "types": ["node"],

    // Safety
    "strict": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    // Behavior
    "skipLibCheck": true,
    "esModuleInterop": true,

    // Output
    "outDir": "dist",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true
  }
}
